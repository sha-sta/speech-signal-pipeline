# pmlab environment — copy to `.env` (gitignored) and fill in. Never commit `.env`.
#
# The app's own settings use the PMLAB_ prefix (pydantic-settings, see src/pmlab/config.py).

# --- Kalshi API auth (read-only market data access — no order endpoints are ever called) ----------
# From kalshi.com → account → API keys. You get a key ID (UUID) and a one-time RSA private key.
# Key ID — paste the UUID:
PMLAB_KALSHI_API_KEY_ID=
# Private key — save the downloaded PEM to secrets/kalshi.pem (secrets/ and *.pem are gitignored;
# a multi-line PEM pasted inline into .env breaks most parsers, so use the file path):
#   mkdir -p secrets && mv ~/Downloads/kalshi*.pem secrets/kalshi.pem && chmod 600 secrets/kalshi.pem
PMLAB_KALSHI_PRIVATE_KEY_PATH=secrets/kalshi.pem

# --- live capture probe ($0 API, zero orders) ------------------------------------------------------
# Phone push notifications via ntfy.sh (optional) — pick an unguessable topic name and subscribe
# to it in the ntfy app. This is a PUBLIC channel name, not a credential; leave blank to disable
# (notifications fall back to a local dry-run log).
PMLAB_NTFY_TOPIC=
# Local Whisper size for $0 ASR (base = faster; small = more accurate). Install: uv sync --extra probe
# PMLAB_WHISPER_MODEL=base

# --- optional app overrides (PMLAB_ prefix; all have sane defaults in config.py) -------------------
# PMLAB_DATA_DIR=data
# PMLAB_KALSHI_RPS=4.0
